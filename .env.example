# interview-tool 配置模板：复制为 .env 后填入真实值（.env 不入库）

# —— 识图链路（quiz P / code Alt+P 截图出答案，必填）——
ARK_API_KEY=            # 视觉模型 API key（兼容 OpenAI /chat/completions）
ARK_VISION_MODEL=       # 视觉模型名，如 deepseek-v4-flash-vision-exp
VISION_BASE_URL=        # API 地址，如 https://api.deepseek.com/v1
VISION_THINKING=        # 截图模型思考开关：enabled / disabled；留空则使用模型默认值
VISION_TIMEOUT_SECONDS= # 单次截图任务总等待上限（秒），默认 120；长推理可设 240

# —— 本地会话数据（默认均开启，保存在 logs/session-时间/）——
SAVE_SCREENSHOTS=true   # 保存实际送入视觉模型的截图
SAVE_AUDIO=true         # 保存整场双轨 WAV 和每次转写对应的 16k WAV 片段
SAVE_TRANSCRIPTS=true   # 保存 transcripts.jsonl，并在会话日志中保留文本

# —— 备用视觉模型（2026-09-09 冗余：主模型失败自动切换，可选）——
# 同服务商多模型：只填 BACKUP_VISION_MODEL 一行即可（key/url 自动复用主的三件套）
# 跨服务商：BACKUP_VISION_API_KEY / MODEL / BASE_URL 全填
BACKUP_VISION_API_KEY=  # 可选：不填复用 ARK_API_KEY（同服务商备胎）
BACKUP_VISION_MODEL=    # 备用模型名，如 doubao-1.5-vision-lite-250315 / qwen-vl-plus
BACKUP_VISION_BASE_URL= # 可选：不填复用 VISION_BASE_URL

# —— 语音问答链路（双轨录音→转写→问答模型作答）——
DEEPSEEK_API_KEY=       # 可选：有值时语音问答优先用 DeepSeek；留空则复用上面的主视觉模型
ANSWER_THINKING=        # 问答模型思考开关：enabled / disabled；留空则使用模型默认值
ISI_APPKEY=             # 云端转写（ISI 实时语音识别）
ALIYUN_AK_ID=           # 转写配套（阿里云 AccessKey，如不需要可留空）
ALIYUN_AK_SECRET=
DASHSCOPE_API_KEY=      # 备用 ASR（fun-asr-realtime），可选

# —— Telegram 手机推送（F6 开关，启动默认开）——
BOT_TOKEN=              # bot token（@BotFather 创建）
ALLOWED_IDS=            # 允许接收的用户 id，多个用英文逗号分隔
PROXY=                  # 推送走代理（socks5/http），直连可留空

# —— 全局快捷键（可选；留空使用右侧默认值）——
# 写法：单键 F7；组合键 Ctrl+Shift+H；多个可选键 F3|P；none 可禁用。
# 所有项都可加 QUIZ_ 或 CODE_ 前缀，只覆盖对应入口，例如 CODE_HOTKEY_TOGGLE_WINDOW=F7。
HOTKEY_RECORD_START=    # F1：开始手动录音
HOTKEY_RECORD_STOP=     # F2：结束手动录音
HOTKEY_VISION=          # quiz 默认 F3|P；code 默认 Alt+P
HOTKEY_TYPE_ANSWER=     # quiz 默认 1；code 默认 Alt+1
HOTKEY_PASTE_ANSWER=    # Alt+2：粘贴答案（code）
HOTKEY_CLEAR_VISION=    # Alt+3：清空识图记忆（code）
HOTKEY_TOGGLE_WINDOW=   # F4：显示/隐藏答案窗
HOTKEY_TOGGLE_PUSH=     # F6：开关手机推送
HOTKEY_TOGGLE_PROMPTER= # F8：开关提词器
HOTKEY_FORCE_MIC=       # F9：按住强制收录麦克风（自动模式）
HOTKEY_TOGGLE_MODE=     # F10：切换模式/回答附注
HOTKEY_HISTORY_PREV=    # Up：上一条历史
HOTKEY_HISTORY_NEXT=    # Down：下一条历史
HOTKEY_PAUSE=           # Ctrl+Esc：暂停/恢复
HOTKEY_EXIT=            # Esc：退出（code 仍需双按）
HOTKEY_EXIT_NOW=        # Ctrl+Q：立即退出
